<Window x:Class="GrayMatch.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GrayMatch.Wpf"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Title="旋转不变 NCC 匹配器 — WPF 演示" Height="820" Width="1280">

    <Window.Resources>
        <local:AngleSignConverter x:Key="AngleNegate"/>
        <!-- 系统内置布尔转可见转换器，无需新建C#类 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 统一紧凑间距样式，复用减少重复代码 -->
        <Style x:Key="CompactText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,1,0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.8"/>
            <Setter Property="Margin" Value="0,2,0,1"/>
        </Style>
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧栏加宽至320 -->
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左侧工具栏（加宽+紧凑布局） -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
            BorderBrush="Gray" BorderThickness="0,0,1,0" Background="#FFF0F0F0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                <StackPanel Margin="0,2">
                    <TextBlock Text="使用说明" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/>
                    <TextBlock Text="1. 点「打开文件夹」选一个放图片的文件夹" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="2. 在照片上随时拖一个框，框住你想找的目标（可重复拖框修改）" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="3. 点「创建模板」，把当前框存成模板并显示在左侧" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="4. 根据需要调整下面的角度范围、相似度等参数" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="5. 点「开始查找」，程序会在图上找出所有相同目标并画绿框" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="6. 点「清除结果」可清掉绿框重新开始（原图和模板还在）" Style="{StaticResource CompactText}"/>

                    <Separator Margin="0,8,0,4"/>
                    <TextBlock Text="操作" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/> 
                    <Button x:Name="BtnOpen" Content="打开文件夹" Style="{StaticResource CompactButton}"
                  ToolTip="点这里选一个放图片的文件夹（bmp / jpg / png 都支持），选好后用上面的列表切换图片"/>
                    <TextBlock Text="图片列表（点一张即载入，自动匹配）" Style="{StaticResource CompactText}"/>
                    <ListBox x:Name="LstImages" Height="92" Margin="0,2,0,6"
            SelectionChanged="LstImages_SelectionChanged"
            ToolTip="打开文件夹后会列出里面的图片，点一张就载入到右侧画布（只载入显示，不会自动跑匹配；要匹配请点「开始查找」）"/>
                    <Button x:Name="BtnCreateTemplate" Content="创建模板" Style="{StaticResource CompactButton}"
                  ToolTip="点这个按钮进入画框模式，然后在图片上拖一个框选中要找的目标（松手即存为模板）"/>

                    <TextBlock Text="模板预览（创建后显示）" Style="{StaticResource ParamLabel}"/>
                    <Border BorderBrush="Gray" BorderThickness="1" Height="165" Margin="0,0,0,4" Background="White">
                        <Image Source="{Binding TemplateBitmap}" Stretch="Uniform" Margin="0,2,0,2"/>
                    </Border>
                    <Separator Margin="0,8,0,4"/>
                    <TextBlock Text="匹配参数" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="起始角度(度) -180~180" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbAngleStartVal" Text="-45" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                    </StackPanel>
                    <Slider x:Name="SldAngleStart" Minimum="-180" Maximum="180" Value="-45" TickFrequency="1"
                            IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1" Margin="0,0,0,4"
                            ValueChanged="MatchParam_Changed"
                            ToolTip="负值逆时针，正值顺时针。范围越大扫描越慢。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="终止角度(度) -180~180" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbAngleEndVal" Text="45" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                    </StackPanel>
                    <Slider x:Name="SldAngleEnd" Minimum="-180" Maximum="180" Value="45" TickFrequency="1"
                            IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1" Margin="0,0,0,4"
                            ValueChanged="MatchParam_Changed"
                            ToolTip="负值逆时针，正值顺时针。范围越大扫描越慢。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="角度步长(度) 越小越慢越精确" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbAngleStepVal" Text="2" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                    </StackPanel>
                    <Slider x:Name="SldAngleStep" Minimum="0.1" Maximum="10" Value="2" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" LargeChange="1" SmallChange="0.1" Margin="0,0,0,4"
                            ValueChanged="MatchParam_Changed"
                            ToolTip="每次旋转增量。1° 适合精细，5° 适合快速粗找。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="NCC相似度阈值 0~1" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbThresholdVal" Text="0.30" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                    </StackPanel>
                    <Slider x:Name="SldThreshold" Minimum="0" Maximum="1" Value="0.30" TickFrequency="0.01"
                            IsSnapToTickEnabled="True" LargeChange="0.05" SmallChange="0.01" Margin="0,0,0,4"
                            ValueChanged="MatchParam_Changed"
                            ToolTip="越高越严格，匹配数量越少。反光/细笔画图建议 0.40 以上。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="最大允许重叠 0~1" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbOverlapVal" Text="0.25" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                    </StackPanel>
                    <Slider x:Name="SldOverlap" Minimum="0" Maximum="1" Value="0.25" TickFrequency="0.01"
                            IsSnapToTickEnabled="True" LargeChange="0.05" SmallChange="0.01" Margin="0,0,0,4"
                            ValueChanged="MatchParam_Changed"
                            ToolTip="两个候选框重叠超过该比例时只保留分数高的。越大越宽松。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="最多输出匹配结果数量" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbTopNVal" Text="20" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                    </StackPanel>
                    <Slider x:Name="SldTopN" Minimum="1" Maximum="500" Value="20" TickFrequency="1"
                            IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1" Margin="0,0,0,4"
                            ValueChanged="MatchParam_Changed"
                            ToolTip="超过该数量就不再输出后续结果。密集阵列可调到 200。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="金字塔层级 0~6" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbPyramidVal" Text="3" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                    </StackPanel>
                    <Slider x:Name="SldPyramid" Minimum="0" Maximum="6" Value="3" TickFrequency="1"
                            IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1" Margin="0,0,0,4"
                            ValueChanged="MatchParam_Changed"
                            ToolTip="层级越高越快，但过小模板或角度大时容易漏检。"/>

                    <Button x:Name="BtnMatchDefaults" Content="恢复默认匹配参数" Height="24" Margin="0,4,0,4" FontSize="10.5"
                            Click="BtnMatchDefaults_Click"
                            ToolTip="将上方所有匹配参数恢复为推荐默认值（-45~45°, 步长2, 阈值0.30, 重叠0.25, TopN20, 金字塔3）"/>

                    <CheckBox x:Name="ChkDense" Content="密集模式（适合规则阵列）" Margin="0,6,0,2" FontSize="11" IsChecked="False"
                      ToolTip="默认不勾选（快速）：种子上限 24，稀疏/普通图几毫秒（实测 ±45°≈5ms），但规则阵列里的大部分重复目标会被漏检，只保留少量代表。&#10;勾选（规则阵列）：粗扫不限制种子数量，可把焊球阵列等成百上千个相同目标全部检出；代价是密集图上耗时会升到十几毫秒（实测 ±45°≈15ms、全 360°≈38ms）。"/>
                    <TextBlock Text="默认不勾选=快速; 规则阵列/密集图才勾选=全检出(较慢)" Style="{StaticResource CompactText}" Foreground="Gray" Margin="0,0,0,2"/>

                    <CheckBox x:Name="ChkContour" Content="轮廓匹配（抗光照变化，绿色轮廓线）" Margin="0,8,0,2" FontSize="11" IsChecked="False"
                      ToolTip="勾选后，匹配改用「边缘梯度图」（Sobel 梯度幅度）代替灰度图，对光照变化、前景背景灰度接近、以及纯形状轮廓（与纹理无关）的图案更鲁棒。&#10;找到的每个目标会用绿色轮廓线画出模板的真实形状（绿框照常显示）。&#10;取消勾选则用原灰度图、只画绿框。缺陷检查始终基于灰度差异，不受影响。"/>

                    <!-- 轮廓匹配参数：仅勾选轮廓匹配时才显示；调参时左侧模板会实时显示绿色轮廓 -->
                    <Border BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3"
                            Padding="6,4" Margin="0,2,0,4" Background="#FFF5FBF5"
                            Visibility="{Binding ElementName=ChkContour, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="轮廓匹配参数" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="平滑（预模糊，也影响匹配）" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbContourBlurVal" Text="1" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                            </StackPanel>
                            <Slider x:Name="SldContourBlur" Minimum="0" Maximum="12" Value="1" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1" Margin="0,0,0,4"
                                    ValueChanged="ContourParam_Changed"
                                    ToolTip="高斯模糊 sigma：0=不模糊，越大噪声越少但边缘越粗（上限 12）"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="轮廓阈值（1-254，越大边越少）" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbContourThresholdVal" Text="30" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                            </StackPanel>
                            <Slider x:Name="SldContourThreshold" Minimum="1" Maximum="254" Value="30" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1" Margin="0,0,0,4"
                                    ValueChanged="ContourParam_Changed"
                                    ToolTip="Canny 低阈值：值越小保留的边越多，值越大只保留最强边缘"/>
                            <TextBlock Text="拖动滑块时左侧模板会实时显示绿色轮廓" Style="{StaticResource CompactText}" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <!-- 多尺度匹配：全局参数，灰度/轮廓模式均生效 -->
                    <StackPanel Margin="0,6,0,4">
                        <TextBlock Text="多尺度匹配（全局，灰度/轮廓均生效）" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="模板大小倍数（0=关）" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TbScaleRangeVal" Text="0.00" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                        </StackPanel>
                        <Slider x:Name="SldScaleRange" Minimum="0" Maximum="0.6" Value="0" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" LargeChange="0.05" SmallChange="0.05" Margin="0,0,0,4"
                                ValueChanged="ContourParam_Changed"
                                ToolTip="多尺度匹配范围（模板大小的倍数）：0 关闭；>0 在 [1-值, 1+值] 区间多尺度搜索（如 0.3 ⇒ 模板在 0.7×~1.3× 大小范围都能被找到）"/>
                    </StackPanel>

                    <Separator Margin="0,8,0,4"/>

 

                    <CheckBox x:Name="ChkDefect" Content="顺便检查缺陷（污渍/划痕/缺料）" Margin="0,8,0,2" FontSize="11"
                  ToolTip="勾选后，除了找目标，还会在每个目标上检查有没有污渍、划痕、缺料等问题，并用红框标出"/>

                    <!-- 修改点：IsEnabled 替换为 Visibility 绑定系统转换器，勾选才显示区域 -->
                    <Border BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3"
                            Padding="6,4" Margin="0,4,0,2" Background="#FFFAFAFA"
                            Visibility="{Binding ElementName=ChkDefect, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="缺陷检测参数" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="差值阈值 1~254" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbDefectDiffVal" Text="45" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                            </StackPanel>
                            <Slider x:Name="SldDefectDiff" Minimum="1" Maximum="254" Value="45" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1" Margin="0,0,0,4"
                                    ValueChanged="DefectParam_Changed"
                                    ToolTip="灰度差超过该值才算异常像素。误检多就调高，漏检就调低。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="边缘容差(px) 0~30" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbDefectEdgeTolVal" Text="0" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                            </StackPanel>
                            <Slider x:Name="SldDefectEdgeTol" Minimum="0" Maximum="30" Value="0" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="2" SmallChange="1" Margin="0,0,0,4"
                                    ValueChanged="DefectParam_Changed"
                                    ToolTip="沿模板轮廓生成的“不关心”带宽度。默认关闭；轮廓误报仍存在时设 2~4。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="边缘梯度阈值 1~254" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbDefectEdgeGradVal" Text="30" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                            </StackPanel>
                            <Slider x:Name="SldDefectEdgeGrad" Minimum="1" Maximum="254" Value="30" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1" Margin="0,0,0,4"
                                    ValueChanged="DefectParam_Changed"
                                    ToolTip="判定“这是模板轮廓”的灰度跳变强度。调低会把更多弱边纳入容差带，抑制更强但更易漏检。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="腐蚀核 0~15" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbDefectErodeVal" Text="2" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                            </StackPanel>
                            <Slider x:Name="SldDefectErode" Minimum="0" Maximum="15" Value="2" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1" Margin="0,0,0,4"
                                    ValueChanged="DefectParam_Changed"
                                    ToolTip="先腐蚀掉细窄的边缘残留。0 或 1 表示不腐蚀。过大会吃掉真实的细划痕。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="膨胀核 0~15" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbDefectDilateVal" Text="3" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                            </StackPanel>
                            <Slider x:Name="SldDefectDilate" Minimum="0" Maximum="15" Value="3" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1" Margin="0,0,0,4"
                                    ValueChanged="DefectParam_Changed"
                                    ToolTip="腐蚀后再膨胀，恢复真实缺陷尺寸并把被腐蚀打断的划痕重新连成一条。建议不小于腐蚀核。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="最小面积占比(%) 0.001~50" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbDefectMinAreaVal" Text="0.40" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                            </StackPanel>
                            <Slider x:Name="SldDefectMinArea" Minimum="0.001" Maximum="50" Value="0.4" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" LargeChange="1" SmallChange="0.05" Margin="0,0,0,4"
                                    ValueChanged="DefectParam_Changed"
                                    ToolTip="小于模板面积该百分比的连通区被忽略，用来滤掉零星噪点。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="全局亮度阈值 1~254" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbDefectGlobalVal" Text="28" Margin="4,0,0,3" FontSize="10.5" FontWeight="Bold" Foreground="#FF2E7D32"/>
                            </StackPanel>
                            <Slider x:Name="SldDefectGlobal" Minimum="1" Maximum="254" Value="28" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1" Margin="0,0,0,2"
                                    ValueChanged="DefectParam_Changed"
                                    ToolTip="没有局部缺陷但整体平均差值超过该值时，标一个“亮度/对比度异常”小徽标。调高可关闭该提示。"/>

                            <Button x:Name="BtnDefectReset" Content="恢复默认参数" Height="24" Margin="0,5,0,0" FontSize="10.5"
                    Click="BtnDefectReset_Click"
                    ToolTip="把上面的缺陷参数恢复成默认值"/>
                        </StackPanel>
                    </Border>

                  
                    <Button x:Name="BtnMatch" Content="开始查找" Style="{StaticResource CompactButton}"
                  ToolTip="设置好上面的参数后，点这里在整张图片里找出所有相同的目标，并用绿框标出"/>
                    <Button x:Name="BtnClear" Content="清除结果" Style="{StaticResource CompactButton}"
                  ToolTip="去掉图上所有的绿框和结果，原图和模板都会保留"/>
                    <Separator Margin="0,8,0,4"/>


                    <TextBlock Text="电脑配置" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/>
                    <TextBlock Text="{Binding ComputerConfigText}" Style="{StaticResource CompactText}"/>

                    <TextBlock Text="图像信息" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/>
                    <TextBlock Text="图像分辨率" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding ImageSizeText}" Margin="0,0,0,4" FontWeight="SemiBold" FontSize="10.5"/>
                    <TextBlock Text="模板分辨率" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding TemplateSizeText}" Margin="0,0,0,4" FontWeight="SemiBold" FontSize="10.5"/> 
                    <TextBlock Text="匹配耗时" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding MatchMsText}" Margin="0,0,0,4" FontWeight="SemiBold" FontSize="10.5"/>

                    <TextBlock Text="缺陷统计" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding DefectSummaryText}" Margin="0,0,0,4" FontWeight="SemiBold" FontSize="10.5" Foreground="Yellow"/>



                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 图像显示画布：滚轮缩放 / 中键拖动平移 / 双击复位（替代原 Viewbox 自适应） -->
        <Border Grid.Column="1" Grid.Row="0" Background="Black">
            <Grid>
                <ScrollViewer x:Name="ImageViewport"
                              Background="Black"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              MouseWheel="ImageArea_MouseWheel"
                              MouseDown="ImageArea_MouseDown"
                              MouseMove="ImageArea_MouseMove"
                              MouseUp="ImageArea_MouseUp"
                              Loaded="ImageViewer_Loaded">
                    <Grid x:Name="ImageGrid"
                          Cursor="Cross"
                          MouseLeftButtonDown="ImageGrid_MouseLeftButtonDown"
                          MouseMove="ImageGrid_MouseMove"
                          MouseLeftButtonUp="ImageGrid_MouseLeftButtonUp"
                          SizeChanged="ImageGrid_SizeChanged">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                    <Image x:Name="SourceImage" Source="{Binding SourceBitmap}" Stretch="None"/>
                    <Canvas IsHitTestVisible="False">
                        <!-- ROI选择框 -->
                        <Rectangle x:Name="RoiRect"
                       Canvas.Left="{Binding RoiLeft}"
                       Canvas.Top="{Binding RoiTop}"
                       Width="{Binding RoiWidth}"
                       Height="{Binding RoiHeight}"
                       Stroke="Lime" StrokeThickness="2" Fill="Transparent"/>

                        <!-- 匹配结果渲染 -->
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftTopX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding LeftTopY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Rectangle Canvas.Left="0" Canvas.Top="0"
                               Width="{Binding TemplateWidth}"
                               Height="{Binding TemplateHeight}"
                               Stroke="Lime" StrokeThickness="2" Fill="Transparent"
                               RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform>
                                                <RotateTransform Angle="{Binding Angle, Converter={StaticResource AngleNegate}}"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <!-- 轮廓匹配：模板边缘形状（绿色线条），与绿框共用同一坐标系，按角度旋转 -->
                                        <Image Canvas.Left="0" Canvas.Top="0"
                               Width="{Binding TemplateWidth}"
                               Height="{Binding TemplateHeight}"
                               Stretch="Fill"
                               Source="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TemplateContourOverlay}"
                               RenderTransformOrigin="0.5,0.5"
                               IsHitTestVisible="False">
                                            <Image.RenderTransform>
                                                <RotateTransform Angle="{Binding Angle, Converter={StaticResource AngleNegate}}"/>
                                            </Image.RenderTransform>
                                        </Image>
                                        <TextBlock Canvas.Left="0" Canvas.Top="-38"
                               Foreground="Lime" FontSize="16" FontWeight="Bold"
                               Text="{Binding Score, StringFormat='相似度:{0:F3}'}"/>
                                        <TextBlock Canvas.Left="0" Canvas.Top="-20"
                               Foreground="Yellow" FontSize="16" FontWeight="Bold"
                               Text="{Binding Angle, StringFormat='角度:{0:F0}°'}"/>
                                        <TextBlock Canvas.Left="0" Canvas.Top="-2"
                               Foreground="Cyan" FontSize="15" FontWeight="Bold"
                               Text="{Binding Scale, StringFormat='大小:{0:F2}倍'}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 缺陷检测叠加层：缺陷像素已在图像上直接用红色标出，这里只保留类型文字说明 -->
                        <ItemsControl ItemsSource="{Binding Defects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftTopX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding LeftTopY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <TextBlock Canvas.Left="{Binding TextLeft}" Canvas.Top="{Binding TextTop}"
                                       Foreground="Yellow" FontSize="12" FontWeight="Bold"
                                       Text="{Binding Type}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                    </Grid>
                </ScrollViewer>
                <TextBlock Text="滚轮缩放 · 中键拖动平移 · 双击复位"
                           Foreground="White" Opacity="0.55" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="10" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
            <TextBlock Text="{Binding StatusText}" Padding="4,2" FontSize="10.5"/>
        </StatusBar>
    </Grid>
</Window>