<Window x:Class="GrayMatch.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GrayMatch.Wpf"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Title="旋转不变 NCC 匹配器 — WPF 演示" Height="820" Width="1280">

    <Window.Resources>
        <local:AngleSignConverter x:Key="AngleNegate"/>
        <!-- 系统内置布尔转可见转换器，无需新建C#类 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 统一紧凑间距样式，复用减少重复代码 -->
        <Style x:Key="CompactText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,1,0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.8"/>
            <Setter Property="Margin" Value="0,2,0,1"/>
        </Style>
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧栏加宽至320 -->
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左侧工具栏（加宽+紧凑布局） -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
            BorderBrush="Gray" BorderThickness="0,0,1,0" Background="#FFF0F0F0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                <StackPanel Margin="0,2">
                    <TextBlock Text="使用说明" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/>
                    <TextBlock Text="1. 点「打开图片」选一张要检测的照片" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="2. 点「创建模板」，进入画框模式" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="3. 在照片上按住鼠标拖一个框，框住你想找的目标（松手即存为模板）" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="4. 根据需要调整下面的角度范围、相似度等参数" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="5. 点「开始查找」，程序会在图上找出所有相同目标并画绿框" Style="{StaticResource CompactText}"/>
                    <TextBlock Text="6. 点「清除结果」可清掉绿框重新开始（原图和模板还在）" Style="{StaticResource CompactText}"/>

                    <Separator Margin="0,8,0,4"/>
                    <TextBlock Text="操作" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/>
                    <Button x:Name="BtnOpen" Content="打开图片" Style="{StaticResource CompactButton}"
                  ToolTip="点这里选一张要检测的图片（bmp / jpg / png 都支持）"/>
                    <Button x:Name="BtnCreateTemplate" Content="创建模板" Style="{StaticResource CompactButton}"
                  ToolTip="点这个按钮进入画框模式，然后在图片上拖一个框选中要找的目标（松手即存为模板）"/>

                    <Separator Margin="0,8,0,4"/>
                    <TextBlock Text="匹配参数" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/>

                    <TextBlock Text="起始角度(度) -180~180" Style="{StaticResource ParamLabel}"/>
                    <TextBox x:Name="TbAngleStart" Text="-180" Margin="0,0,0,4" FontSize="10.5"/>

                    <TextBlock Text="终止角度(度)" Style="{StaticResource ParamLabel}"/>
                    <TextBox x:Name="TbAngleEnd" Text="180" Margin="0,0,0,4" FontSize="10.5"/>

                    <TextBlock Text="角度步长(度) 越大越快精度越低" Style="{StaticResource ParamLabel}"/>
                    <TextBox x:Name="TbAngleStep" Text="1" Margin="0,0,0,4" FontSize="10.5"/>

                    <TextBlock Text="NCC相似度阈值 0~1，越高越严格" Style="{StaticResource ParamLabel}"/>
                    <TextBox x:Name="TbThreshold" Text="0.5" Margin="0,0,0,4" FontSize="10.5"/>

                    <TextBlock Text="最大允许重叠 过滤重复匹配" Style="{StaticResource ParamLabel}"/>
                    <TextBox x:Name="TbOverlap" Text="0.1" Margin="0,0,0,4" FontSize="10.5"/>

                    <TextBlock Text="最多输出匹配结果数量" Style="{StaticResource ParamLabel}"/>
                    <TextBox x:Name="TbTopN" Text="64" Margin="0,0,0,4" FontSize="10.5"/>

                    <TextBlock Text="金字塔层级 层级越高速度越快" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="CmbPyramid" SelectedIndex="3" IsReadOnly="True" Margin="0,0,0,4" FontSize="10.5">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                    </ComboBox>

                    <Separator Margin="0,8,0,4"/>

 

                    <CheckBox x:Name="ChkDefect" Content="顺便检查缺陷（污渍/划痕/缺料）" Margin="0,8,0,2" FontSize="11"
                  ToolTip="勾选后，除了找目标，还会在每个目标上检查有没有污渍、划痕、缺料等问题，并用红框标出"/>

                    <!-- 修改点：IsEnabled 替换为 Visibility 绑定系统转换器，勾选才显示区域 -->
                    <Border BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3"
                            Padding="6,4" Margin="0,4,0,2" Background="#FFFAFAFA"
                            Visibility="{Binding ElementName=ChkDefect, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="缺陷检测参数" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,4"/>

                            <TextBlock Text="差值阈值 10~120，越低越灵敏" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TbDefectDiff" Text="45" Margin="0,0,0,4" FontSize="10.5"
                     TextChanged="DefectParam_Changed"
                     ToolTip="灰度差超过该值才算异常像素。误检多就调高，漏检就调低。"/>

                            <TextBlock Text="边缘容差(px) 0=关，仍误报时设2~4" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TbDefectEdgeTol" Text="0" Margin="0,0,0,4" FontSize="10.5"
                     TextChanged="DefectParam_Changed"
                     ToolTip="沿模板轮廓生成的“不关心”带宽度，是腐蚀膨胀之外的额外保险。默认关闭：实测腐蚀膨胀已能清除全部轮廓误报，而 3px 容差带会把一条真实的 20px 划痕削到 8px。轮廓误报仍然存在时再设 2~4。"/>

                            <TextBlock Text="边缘梯度阈值 5~120，越低带越宽" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TbDefectEdgeGrad" Text="30" Margin="0,0,0,4" FontSize="10.5"
                     TextChanged="DefectParam_Changed"
                     ToolTip="判定“这是模板轮廓”的灰度跳变强度。调低会把更多弱边纳入容差带，抑制更强但更易漏检。"/>

                            <TextBlock Text="腐蚀核 0/2~7，消细边残留" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TbDefectErode" Text="2" Margin="0,0,0,4" FontSize="10.5"
                     TextChanged="DefectParam_Changed"
                     ToolTip="先腐蚀掉细窄的边缘残留。填 0 或 1 表示不腐蚀。过大会吃掉真实的细划痕。"/>

                            <TextBlock Text="膨胀核 0/2~7，恢复缺陷面积" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TbDefectDilate" Text="3" Margin="0,0,0,4" FontSize="10.5"
                     TextChanged="DefectParam_Changed"
                     ToolTip="腐蚀后再膨胀，恢复真实缺陷尺寸并把被腐蚀打断的划痕重新连成一条。建议不小于腐蚀核。"/>

                            <TextBlock Text="最小面积占比(%) 0.05~5" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TbDefectMinArea" Text="0.4" Margin="0,0,0,4" FontSize="10.5"
                     TextChanged="DefectParam_Changed"
                     ToolTip="小于模板面积该百分比的连通区被忽略，用来滤掉零星噪点。"/>

                            <TextBlock Text="全局亮度阈值 5~80" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TbDefectGlobal" Text="28" Margin="0,0,0,2" FontSize="10.5"
                     TextChanged="DefectParam_Changed"
                     ToolTip="没有局部缺陷但整体平均差值超过该值时，标一个“亮度/对比度异常”小徽标。调高可关闭该提示。"/>

                            <!--<Button x:Name="BtnDefectReset" Content="恢复默认参数" Height="24" Margin="0,5,0,0" FontSize="10.5"
                    Click="BtnDefectReset_Click"
                    ToolTip="把上面的缺陷参数恢复成默认值"/>-->
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnMatch" Content="开始查找" Style="{StaticResource CompactButton}"
                  ToolTip="设置好上面的参数后，点这里在整张图片里找出所有相同的目标，并用绿框标出"/>
                    <Button x:Name="BtnClear" Content="清除结果" Style="{StaticResource CompactButton}"
                  ToolTip="去掉图上所有的绿框和结果，原图和模板都会保留"/>
                    <Separator Margin="0,8,0,4"/>


                    <TextBlock Text="电脑配置" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/>
                    <TextBlock Text="{Binding ComputerConfigText}" Style="{StaticResource CompactText}"/>

                    <TextBlock Text="图像信息" FontWeight="Bold" FontSize="12" Margin="0,1,0,4"/>
                    <TextBlock Text="图像分辨率" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding ImageSizeText}" Margin="0,0,0,4" FontWeight="SemiBold" FontSize="10.5"/>
                    <TextBlock Text="模板分辨率" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding TemplateSizeText}" Margin="0,0,0,4" FontWeight="SemiBold" FontSize="10.5"/>
                    <TextBlock Text="匹配耗时" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding MatchMsText}" Margin="0,0,0,4" FontWeight="SemiBold" FontSize="10.5"/>

                    <TextBlock Text="缺陷统计" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding DefectSummaryText}" Margin="0,0,0,4" FontWeight="SemiBold" FontSize="10.5" Foreground="Red"/>



                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 图像显示画布：滚轮缩放 / 中键拖动平移 / 双击复位（替代原 Viewbox 自适应） -->
        <Border Grid.Column="1" Grid.Row="0" Background="Black">
            <Grid>
                <ScrollViewer x:Name="ImageViewport"
                              Background="Black"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              MouseWheel="ImageArea_MouseWheel"
                              MouseDown="ImageArea_MouseDown"
                              MouseMove="ImageArea_MouseMove"
                              MouseUp="ImageArea_MouseUp"
                              Loaded="ImageViewer_Loaded">
                    <Grid x:Name="ImageGrid"
                          Cursor="Cross"
                          MouseLeftButtonDown="ImageGrid_MouseLeftButtonDown"
                          MouseMove="ImageGrid_MouseMove"
                          MouseLeftButtonUp="ImageGrid_MouseLeftButtonUp"
                          SizeChanged="ImageGrid_SizeChanged">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                    <Image x:Name="SourceImage" Source="{Binding SourceBitmap}" Stretch="None"/>
                    <Canvas IsHitTestVisible="False">
                        <!-- ROI选择框 -->
                        <Rectangle x:Name="RoiRect"
                       Canvas.Left="{Binding RoiLeft}"
                       Canvas.Top="{Binding RoiTop}"
                       Width="{Binding RoiWidth}"
                       Height="{Binding RoiHeight}"
                       Stroke="Lime" StrokeThickness="2" Fill="Transparent"/>

                        <!-- 匹配结果渲染 -->
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftTopX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding LeftTopY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Rectangle Canvas.Left="0" Canvas.Top="0"
                               Width="{Binding TemplateWidth}"
                               Height="{Binding TemplateHeight}"
                               Stroke="Lime" StrokeThickness="2" Fill="Transparent"
                               RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform>
                                                <RotateTransform Angle="{Binding Angle, Converter={StaticResource AngleNegate}}"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <TextBlock Canvas.Left="0" Canvas.Top="-38"
                               Foreground="Lime" FontSize="16" FontWeight="Bold"
                               Text="{Binding Score, StringFormat='相似度:{0:F3}'}"/>
                                        <TextBlock Canvas.Left="0" Canvas.Top="-20"
                               Foreground="Yellow" FontSize="16" FontWeight="Bold"
                               Text="{Binding Angle, StringFormat='角度:{0:F0}°'}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 缺陷检测叠加层：缺陷像素已在图像上直接用红色标出，这里只保留类型文字说明 -->
                        <ItemsControl ItemsSource="{Binding Defects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftTopX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding LeftTopY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <TextBlock Canvas.Left="{Binding TextLeft}" Canvas.Top="{Binding TextTop}"
                                       Foreground="Red" FontSize="12" FontWeight="Bold"
                                       Text="{Binding Type}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                    </Grid>
                </ScrollViewer>
                <TextBlock Text="滚轮缩放 · 中键拖动平移 · 双击复位"
                           Foreground="White" Opacity="0.55" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="10" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
            <TextBlock Text="{Binding StatusText}" Padding="4,2" FontSize="10.5"/>
        </StatusBar>
    </Grid>
</Window>