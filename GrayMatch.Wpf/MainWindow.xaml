<Window x:Class="GrayMatch.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GrayMatch.Wpf"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        Title="旋转不变 NCC 匹配器 — WPF 演示" Height="840" Width="1320">

    <Window.Resources>
        <local:AngleSignConverter x:Key="AngleNegate"/>
        <!-- 系统内置布尔转可见转换器，无需新建C#类 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ===================== 调色板 / 主题 ===================== -->
        <!-- Primary #2563EB  Accent #1D4ED8  Text #0F172A  Sub #64748B  Border #E2E8F0  Surface #FFFFFF -->

        <!-- ===================== 图标（矢量 Path，无外部依赖） ===================== -->
        <DrawingImage x:Key="IconTarget">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#0F172A" Geometry="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10 10-4.49 10-10S17.51 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconHelp">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconFolder">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconCrop">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M3 5v4h2V5h4V3H5c-1.1 0-2 .9-2 2zm2 10H3v6c0 1.1.9 2 2 2h6v-2H5v-6zm14 0v6h-6v2h6c1.1 0 2-.9 2-2v-6h-2zm0-16h-6v2h6v6h2V5c0-1.1-.9-2-2-2z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconSweep">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M15 16h4v2h-4zm0-8h7v2h-7zm0 4h6v2h-6zM3 18c0 1.1.9 2 2 2h6c1.1 0 2-.9 2-2V8H3v10zM14 5h-3l-1-1H6L5 5H2v2h12z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconRefresh">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconTune">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconContour">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconScale">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M22 3l-4 4h3v4h-2V8.41l-4 4L12 9.83 16.59 5H14V3h8zM2 21l4-4H3v-4h2v3.59l4-4L12 14.17 7.41 19H10v2H2z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconAlert">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#DC2626" Geometry="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconCpu">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M22 9V7h-2V5c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2v-2h-2V9h2zm-4 10H4V5h14v14zM6 7h10v10H6V7zm2 2v6h6V9H8z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconInfo">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#0F172A" Geometry="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconClock">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2563EB" Geometry="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ===================== 通用样式 ===================== -->
        <Style x:Key="CompactText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.8"/>
            <Setter Property="Margin" Value="0,1,0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.8"/>
            <Setter Property="Margin" Value="0,2,0,1"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="Margin" Value="4,0,0,2"/>
        </Style>

        <!-- 卡片容器 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.07" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 区块标题（图标 + 文字） -->
        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 普通按钮 -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（开始查找） -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#93C5FD"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 链接式小按钮（恢复默认） -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource IconRefresh}" Width="13" Height="13" Margin="0,0,5,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复选框 -->
        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 滑块 -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="White" Stroke="#2563EB" StrokeThickness="3"/>
                            <Ellipse Fill="#2563EB" Width="5" Height="5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track Grid.Row="1" x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="#2563EB" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="#E2E8F0" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 信息区标签/值 -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="20,2,0,1"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="20,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="#1E40AF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#0F172A"/>
            </Border.Effect>
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="9" Padding="9" Margin="0,0,12,0">
                        <Path Data="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10 10-4.49 10-10S17.51 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"
                              Fill="#2563EB" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="旋转不变 NCC 匹配器" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="WPF 演示 · 灰度 / 轮廓匹配 · 缺陷检测" Foreground="#BFDBFE" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="#1D4ED8" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="实时预览 · 拖滑块即刷新" Foreground="#EFF6FF" FontSize="10.5" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 左侧工具栏 -->
        <Border Grid.Column="0" Grid.Row="1" Background="#F1F5F9">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,10,8,10">
                <StackPanel>

                    <!-- 使用说明 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionHeader}">
                                <Image Source="{StaticResource IconHelp}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="使用说明" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <TextBlock Text="1. 点「打开文件夹」选一个放图片的文件夹" Style="{StaticResource CompactText}"/>
                            <TextBlock Text="2. 在照片上随时拖一个框，框住你想找的目标（可重复拖框修改）" Style="{StaticResource CompactText}"/>
                            <TextBlock Text="3. 点「创建模板」，把当前框存成模板并显示在左侧" Style="{StaticResource CompactText}"/>
                            <TextBlock Text="4. 根据需要调整下面的角度范围、相似度等参数" Style="{StaticResource CompactText}"/>
                            <TextBlock Text="5. 点「开始查找」，程序会在图上找出所有相同目标并画绿框" Style="{StaticResource CompactText}"/>
                            <TextBlock Text="6. 点「清除结果」可清掉绿框重新开始（原图和模板还在）" Style="{StaticResource CompactText}"/>
                        </StackPanel>
                    </Border>

                    <!-- 操作 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionHeader}">
                                <Image Source="{StaticResource IconFolder}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="操作" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <Button x:Name="BtnOpen" Style="{StaticResource ModernButton}"
                                    ToolTip="点这里选一个放图片的文件夹（bmp / jpg / png 都支持），选好后用上面的列表切换图片">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconFolder}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="打开文件夹" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="图片列表（点一张即载入，自动匹配）" Style="{StaticResource CompactText}" Margin="0,8,0,2"/>
                            <ListBox x:Name="LstImages" Height="92" Margin="0,0,0,6"
                                     BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC"
                                     SelectionChanged="LstImages_SelectionChanged"
                                     ToolTip="打开文件夹后会列出里面的图片，点一张就载入到右侧画布（只载入显示，不会自动跑匹配；要匹配请点「开始查找」)">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource IconImage}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="11.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button x:Name="BtnCreateTemplate" Style="{StaticResource ModernButton}" Margin="0,2,0,0"
                                    ToolTip="点这个按钮进入画框模式，然后在图片上拖一个框选中要找的目标（松手即存为模板）">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconCrop}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="创建模板" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="模板预览（创建后显示）" Style="{StaticResource ParamLabel}" Margin="0,10,0,3"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="165" Margin="0,0,0,2" Background="#F8FAFC">
                                <Image Source="{Binding TemplateBitmap}" Stretch="Uniform" Margin="4"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 匹配参数 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionHeader}">
                                <Image Source="{StaticResource IconTune}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="匹配参数" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="起始角度(度) -180~180" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbAngleStartVal" Text="-45" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldAngleStart" Style="{StaticResource ModernSlider}" Minimum="-180" Maximum="180" Value="-45" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1"
                                    ValueChanged="MatchParam_Changed"
                                    ToolTip="负值逆时针，正值顺时针。范围越大扫描越慢。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="终止角度(度) -180~180" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbAngleEndVal" Text="45" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldAngleEnd" Style="{StaticResource ModernSlider}" Minimum="-180" Maximum="180" Value="45" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1"
                                    ValueChanged="MatchParam_Changed"
                                    ToolTip="负值逆时针，正值顺时针。范围越大扫描越慢。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="角度步长(度) 越小越慢越精确" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbAngleStepVal" Text="2" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldAngleStep" Style="{StaticResource ModernSlider}" Minimum="0.1" Maximum="10" Value="2" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" LargeChange="1" SmallChange="0.1"
                                    ValueChanged="MatchParam_Changed"
                                    ToolTip="每次旋转增量。1° 适合精细，5° 适合快速粗找。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="NCC相似度阈值 0~1" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbThresholdVal" Text="0.30" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldThreshold" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="1" Value="0.30" TickFrequency="0.01"
                                    IsSnapToTickEnabled="True" LargeChange="0.05" SmallChange="0.01"
                                    ValueChanged="MatchParam_Changed"
                                    ToolTip="越高越严格，匹配数量越少。反光/细笔画图建议 0.40 以上。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="最大允许重叠 0~1" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbOverlapVal" Text="0.25" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldOverlap" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="1" Value="0.25" TickFrequency="0.01"
                                    IsSnapToTickEnabled="True" LargeChange="0.05" SmallChange="0.01"
                                    ValueChanged="MatchParam_Changed"
                                    ToolTip="两个候选框重叠超过该比例时只保留分数高的。越大越宽松。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="最多输出匹配结果数量" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbTopNVal" Text="20" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldTopN" Style="{StaticResource ModernSlider}" Minimum="1" Maximum="500" Value="20" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1"
                                    ValueChanged="MatchParam_Changed"
                                    ToolTip="超过该数量就不再输出后续结果。密集阵列可调到 200。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="金字塔层级 0~6" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbPyramidVal" Text="3" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldPyramid" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="6" Value="3" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1"
                                    ValueChanged="MatchParam_Changed"
                                    ToolTip="层级越高越快，但过小模板或角度大时容易漏检。&#10;轮廓匹配开启时此参数被忽略。"/>

                            <Button x:Name="BtnMatchDefaults" Style="{StaticResource LinkButton}" Margin="0,4,0,2"
                                    Click="BtnMatchDefaults_Click"
                                    ToolTip="将上方所有匹配参数恢复为推荐默认值（-45~45°, 步长2, 阈值0.30, 重叠0.25, TopN20, 金字塔3）">
                                <TextBlock Text="恢复默认匹配参数" VerticalAlignment="Center" FontSize="11"/>
                            </Button>

                            <CheckBox x:Name="ChkDense" Style="{StaticResource ModernCheck}" Content="密集模式（适合规则阵列）" IsChecked="False"
                                      ToolTip="默认不勾选（快速）：种子上限 24，稀疏/普通图几毫秒（实测 ±45°≈5ms），但规则阵列里的大部分重复目标会被漏检，只保留少量代表。&#10;勾选（规则阵列）：粗扫不限制种子数量，可把焊球阵列等成百上千个相同目标全部检出；代价是密集图上耗时会升到十几毫秒（实测 ±45°≈15ms、全 360°≈38ms）。"/>
                            <TextBlock Text="默认不勾选=快速; 规则阵列/密集图才勾选=全检出(较慢)" Style="{StaticResource CompactText}" Foreground="#94A3B8" Margin="0,0,0,2"/>

                            <CheckBox x:Name="ChkContour" Style="{StaticResource ModernCheck}" Content="轮廓匹配（抗光照变化，绿色轮廓线）" IsChecked="False"
                                      ToolTip="勾选后，匹配改用「边缘梯度图」（Sobel 梯度幅度）代替灰度图，对光照变化、前景背景灰度接近、以及纯形状轮廓（与纹理无关）的图案更鲁棒。&#10;找到的每个目标会用绿色轮廓线画出模板的真实形状（绿框照常显示）。&#10;注意：轮廓匹配会自动忽略「金字塔层级」（边缘图下采样会抹糊细边），建议把 NCC 阈值提高到 0.40 以上，否则容易出现假阳性。"/>
                        </StackPanel>
                    </Border>

                    <!-- 轮廓匹配参数 -->
                    <Border BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10"
                            Padding="12,10" Margin="0,0,0,10" Background="#EFF6FF"
                            Visibility="{Binding ElementName=ChkContour, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionHeader}">
                                <Image Source="{StaticResource IconContour}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="轮廓匹配参数" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="平滑（预模糊，也影响匹配）" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbContourBlurVal" Text="1" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldContourBlur" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="12" Value="1" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1"
                                    ValueChanged="ContourParam_Changed"
                                    ToolTip="高斯模糊 sigma：0=不模糊，越大噪声越少但边缘越粗（上限 12）"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="轮廓阈值（1-254，越大边越少）" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbContourThresholdVal" Text="30" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldContourThreshold" Style="{StaticResource ModernSlider}" Minimum="1" Maximum="254" Value="30" TickFrequency="1"
                                    IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1"
                                    ValueChanged="ContourParam_Changed"
                                    ToolTip="Canny 低阈值：值越小保留的边越多，值越大只保留最强边缘"/>
                            <TextBlock Text="拖动滑块时左侧模板会实时显示绿色轮廓" Style="{StaticResource CompactText}" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- 多尺度匹配 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionHeader}">
                                <Image Source="{StaticResource IconScale}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="多尺度匹配（全局）" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <TextBlock Text="灰度 / 轮廓模式均生效" Style="{StaticResource CompactText}" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="模板大小倍数（0=关）" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbScaleRangeVal" Text="0.00" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <Slider x:Name="SldScaleRange" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="0.6" Value="0" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" LargeChange="0.05" SmallChange="0.05"
                                    ValueChanged="ContourParam_Changed"
                                    ToolTip="多尺度匹配范围（模板大小的倍数）：0 关闭；>0 在 [1-值, 1+值] 区间多尺度搜索（如 0.3 ⇒ 模板在 0.7×~1.3× 大小范围都能被找到）"/>
                        </StackPanel>
                    </Border>

                    <!-- 缺陷检测 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionHeader}">
                                <Image Source="{StaticResource IconAlert}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="缺陷检测" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkDefect" Style="{StaticResource ModernCheck}" Content="顺便检查缺陷（污渍/划痕/缺料）"
                                      ToolTip="勾选后，除了找目标，还会在每个目标上检查有没有污渍、划痕、缺料等问题，并用红框标出"/>

                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                    Padding="8,6" Margin="0,4,0,2" Background="#F8FAFC"
                                    Visibility="{Binding ElementName=ChkDefect, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="缺陷检测参数" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,6" Foreground="#0F172A"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="差值阈值 1~254" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbDefectDiffVal" Text="45" Style="{StaticResource ValueText}"/>
                                    </StackPanel>
                                    <Slider x:Name="SldDefectDiff" Style="{StaticResource ModernSlider}" Minimum="1" Maximum="254" Value="45" TickFrequency="1"
                                            IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1"
                                            ValueChanged="DefectParam_Changed"
                                            ToolTip="灰度差超过该值才算异常像素。误检多就调高，漏检就调低。"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="边缘容差(px) 0~30" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbDefectEdgeTolVal" Text="0" Style="{StaticResource ValueText}"/>
                                    </StackPanel>
                                    <Slider x:Name="SldDefectEdgeTol" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="30" Value="0" TickFrequency="1"
                                            IsSnapToTickEnabled="True" LargeChange="2" SmallChange="1"
                                            ValueChanged="DefectParam_Changed"
                                            ToolTip="沿模板轮廓生成的“不关心”带宽度。默认关闭；轮廓误报仍存在时设 2~4。"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="边缘梯度阈值 1~254" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbDefectEdgeGradVal" Text="30" Style="{StaticResource ValueText}"/>
                                    </StackPanel>
                                    <Slider x:Name="SldDefectEdgeGrad" Style="{StaticResource ModernSlider}" Minimum="1" Maximum="254" Value="30" TickFrequency="1"
                                            IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1"
                                            ValueChanged="DefectParam_Changed"
                                            ToolTip="判定“这是模板轮廓”的灰度跳变强度。调低会把更多弱边纳入容差带，抑制更强但更易漏检。"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="腐蚀核 0~15" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbDefectErodeVal" Text="2" Style="{StaticResource ValueText}"/>
                                    </StackPanel>
                                    <Slider x:Name="SldDefectErode" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="15" Value="2" TickFrequency="1"
                                            IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1"
                                            ValueChanged="DefectParam_Changed"
                                            ToolTip="先腐蚀掉细窄的边缘残留。0 或 1 表示不腐蚀。过大会吃掉真实的细划痕。"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="膨胀核 0~15" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbDefectDilateVal" Text="3" Style="{StaticResource ValueText}"/>
                                    </StackPanel>
                                    <Slider x:Name="SldDefectDilate" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="15" Value="3" TickFrequency="1"
                                            IsSnapToTickEnabled="True" LargeChange="1" SmallChange="1"
                                            ValueChanged="DefectParam_Changed"
                                            ToolTip="腐蚀后再膨胀，恢复真实缺陷尺寸并把被腐蚀打断的划痕重新连成一条。建议不小于腐蚀核。"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="最小面积占比(%) 0.001~50" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbDefectMinAreaVal" Text="0.40" Style="{StaticResource ValueText}"/>
                                    </StackPanel>
                                    <Slider x:Name="SldDefectMinArea" Style="{StaticResource ModernSlider}" Minimum="0.001" Maximum="50" Value="0.4" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" LargeChange="1" SmallChange="0.05"
                                            ValueChanged="DefectParam_Changed"
                                            ToolTip="小于模板面积该百分比的连通区被忽略，用来滤掉零星噪点。"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="全局亮度阈值 1~254" Style="{StaticResource CompactText}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbDefectGlobalVal" Text="28" Style="{StaticResource ValueText}"/>
                                    </StackPanel>
                                    <Slider x:Name="SldDefectGlobal" Style="{StaticResource ModernSlider}" Minimum="1" Maximum="254" Value="28" TickFrequency="1"
                                            IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1"
                                            ValueChanged="DefectParam_Changed"
                                            ToolTip="没有局部缺陷但整体平均差值超过该值时，标一个“亮度/对比度异常”小徽标。调高可关闭该提示。"/>

                                    <Button x:Name="BtnDefectReset" Style="{StaticResource LinkButton}" Margin="0,4,0,0"
                                            Click="BtnDefectReset_Click"
                                            ToolTip="把上面的缺陷参数恢复成默认值">
                                        <TextBlock Text="恢复默认参数" VerticalAlignment="Center" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 开始查找 / 清除结果 -->
                    <Button x:Name="BtnMatch" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                            ToolTip="设置好上面的参数后，点这里在整张图片里找出所有相同的目标，并用绿框标出">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="White" Width="18" Height="18" Margin="0,0,8,0" Stretch="Uniform"/>
                            <TextBlock Text="开始查找" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClear" Style="{StaticResource ModernButton}"
                            ToolTip="去掉图上所有的绿框和结果，原图和模板都会保留">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource IconSweep}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="清除结果" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- 信息面板 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionHeader}">
                                <Image Source="{StaticResource IconInfo}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="图像与运行状态" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <Image Source="{StaticResource IconCpu}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="电脑配置" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ComputerConfigText}" Style="{StaticResource InfoValue}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <Image Source="{StaticResource IconImage}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="图像分辨率" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ImageSizeText}" Style="{StaticResource InfoValue}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <Image Source="{StaticResource IconCrop}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="模板分辨率" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TemplateSizeText}" Style="{StaticResource InfoValue}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <Image Source="{StaticResource IconClock}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="匹配耗时" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MatchMsText}" Style="{StaticResource InfoValue}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <Image Source="{StaticResource IconAlert}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="缺陷统计" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DefectSummaryText}" Style="{StaticResource InfoValue}" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 图像显示画布：滚轮缩放 / 中键拖动平移 / 双击复位（替代原 Viewbox 自适应） -->
        <Border Grid.Column="1" Grid.Row="1" Background="#0F172A">
            <Grid>
                <ScrollViewer x:Name="ImageViewport"
                              Background="#0F172A"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              MouseWheel="ImageArea_MouseWheel"
                              MouseDown="ImageArea_MouseDown"
                              MouseMove="ImageArea_MouseMove"
                              MouseUp="ImageArea_MouseUp"
                              Loaded="ImageViewer_Loaded">
                    <Grid x:Name="ImageGrid"
                          Cursor="Cross"
                          MouseLeftButtonDown="ImageGrid_MouseLeftButtonDown"
                          MouseMove="ImageGrid_MouseMove"
                          MouseLeftButtonUp="ImageGrid_MouseLeftButtonUp"
                          SizeChanged="ImageGrid_SizeChanged">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                    <Image x:Name="SourceImage" Source="{Binding SourceBitmap}" Stretch="None"/>
                    <Canvas IsHitTestVisible="False">
                        <!-- ROI选择框 -->
                        <Rectangle x:Name="RoiRect"
                       Canvas.Left="{Binding RoiLeft}"
                       Canvas.Top="{Binding RoiTop}"
                       Width="{Binding RoiWidth}"
                       Height="{Binding RoiHeight}"
                       Stroke="Lime" StrokeThickness="2" Fill="Transparent"/>

                        <!-- 匹配结果渲染 -->
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftTopX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding LeftTopY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Rectangle Canvas.Left="0" Canvas.Top="0"
                               Width="{Binding TemplateWidth}"
                               Height="{Binding TemplateHeight}"
                               Stroke="Lime" StrokeThickness="2" Fill="Transparent"
                               RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform>
                                                <RotateTransform Angle="{Binding Angle, Converter={StaticResource AngleNegate}}"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <!-- 轮廓匹配：模板边缘形状（绿色线条），与绿框共用同一坐标系，按角度旋转 -->
                                        <Image Canvas.Left="0" Canvas.Top="0"
                               Width="{Binding TemplateWidth}"
                               Height="{Binding TemplateHeight}"
                               Stretch="Fill"
                               Source="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TemplateContourOverlay}"
                               RenderTransformOrigin="0.5,0.5"
                               IsHitTestVisible="False">
                                            <Image.RenderTransform>
                                                <RotateTransform Angle="{Binding Angle, Converter={StaticResource AngleNegate}}"/>
                                            </Image.RenderTransform>
                                        </Image>
                                        <TextBlock Canvas.Left="0" Canvas.Top="-38"
                               Foreground="Lime" FontSize="16" FontWeight="Bold"
                               Text="{Binding Score, StringFormat='相似度:{0:F3}'}"/>
                                        <TextBlock Canvas.Left="0" Canvas.Top="-20"
                               Foreground="Yellow" FontSize="16" FontWeight="Bold"
                               Text="{Binding Angle, StringFormat='角度:{0:F0}°'}"/>
                                        <TextBlock Canvas.Left="0" Canvas.Top="-2"
                               Foreground="Cyan" FontSize="15" FontWeight="Bold"
                               Text="{Binding Scale, StringFormat='大小:{0:F2}倍'}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 缺陷检测叠加层：缺陷像素已在图像上直接用红色标出，这里只保留类型文字说明 -->
                        <ItemsControl ItemsSource="{Binding Defects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftTopX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding LeftTopY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <TextBlock Canvas.Left="{Binding TextLeft}" Canvas.Top="{Binding TextTop}"
                                       Foreground="Yellow" FontSize="12" FontWeight="Bold"
                                       Text="{Binding Type}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                    </Grid>
                </ScrollViewer>
                <TextBlock Text="滚轮缩放 · 中键拖动平移 · 双击复位"
                           Foreground="White" Opacity="0.55" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="10" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                   BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StatusBar.Background>
                <SolidColorBrush Color="#FFFFFF"/>
            </StatusBar.Background>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <Image Source="{StaticResource IconInfo}" Width="14" Height="14" Margin="10,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" Padding="0,3" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
        </StatusBar>
    </Grid>
</Window>